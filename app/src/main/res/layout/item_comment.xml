<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Author and Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CyberStudent"
            android:textColor="#39BF8F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSolutionBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_circle"
            app:tint="#39BF8F"
            android:layout_marginStart="6dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45 minutes ago"
            android:textColor="#8B949E"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Content -->
    <TextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is a great solution! I followed your steps and it worked perfectly."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="12dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Upvote -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnUpvote"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_upvote_outline"
                app:tint="#8B949E" />

            <TextView
                android:id="@+id/tvUpvotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Reply -->
        <ImageView
            android:id="@+id/btnReply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_reply"
            app:tint="#8B949E"
            android:layout_marginStart="16dp" />

        <!-- Mark as Solution -->
        <TextView
            android:id="@+id/btnMarkSolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark as Solution"
            android:textColor="#39BF8F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_border_green"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="16dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>