<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#111827"
    app:cardUseCompatPadding="false"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with icon and badges -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Icon -->
            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:background="@drawable/bg_icon_circle"
                app:tint="@color/cyber_text_primary" />

            <!-- Category name and description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivIcon"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="28dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCategoryName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category Name"
                    android:textColor="@color/cyber_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category description here"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>


            <!-- Pinned badge -->
            <ImageView
                android:id="@+id/ivPinnedBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_pin"
                app:tint="@color/cyber_orange_premium"
                android:visibility="gone" />

            <!-- New posts badge -->
            <ImageView
                android:id="@+id/ivNewBadge"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_alignEnd="@id/ivIcon"
                android:layout_alignTop="@id/ivIcon"
                android:layout_marginEnd="-4dp"
                android:layout_marginTop="-4dp"
                android:src="@drawable/ic_circle"
                app:tint="@color/cyber_green_main"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- Stats and action -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cyber_border"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <!-- Topic count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_topic"
                    app:tint="@color/cyber_text_secondary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvTopicCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="234 topics"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Post count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_message"
                    app:tint="@color/cyber_text_secondary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvPostCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.5k posts"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- View button -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View"
                android:textColor="@color/cyber_green_main"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingVertical="4dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_view_button" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>