<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/cyber_dark_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cyber_card_background"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/cyber_text_primary">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General Discussion"
                android:textColor="@color/cyber_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/ivFilter" />

            <ImageView
                android:id="@+id/ivFilter"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_filter"
                android:tint="@color/cyber_text_secondary"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </RelativeLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/cyber_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                android:tint="@color/cyber_text_secondary" />

            <EditText
                android:id="@+id/etSearchThreads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search in this category..."
                android:textColor="@color/cyber_text_primary"
                android:textColorHint="@color/cyber_text_secondary"
                android:background="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Thread List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThreads"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_empty_threads"
            android:tint="@color/cyber_text_secondary"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No threads yet"
            android:textColor="@color/cyber_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Be the first to start a discussion!"
            android:textColor="@color/cyber_text_secondary"
            android:textSize="14sp"
            android:textAlignment="center" />

        <Button
            android:id="@+id/btnStartThread"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Start New Thread"
            android:textColor="@color/cyber_text_primary"
            android:background="@drawable/bg_button_green"
            android:layout_marginTop="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:visibility="gone" />

</LinearLayout>